#!/bin/sh
# Refuse a push whose docs/ does not match what build.py would produce from data/.
#
# The failure this exists to stop: GitHub Pages serves main:/docs directly, and this
# repository has no build Action. Editing data/*.yaml and pushing without running
# build.py therefore changes nothing on magnuslodefalk.com, silently. No job fails,
# no warning appears, and the site simply keeps serving the previous HTML.
#
# The check rebuilds into a temporary directory and compares, rather than comparing
# timestamps, which are meaningless after a fresh clone or a checkout.
#
# Fails OPEN if the build cannot run at all (no python3, no PyYAML): a broken toolchain
# should not block a push. Fails CLOSED only on a real mismatch. Bypass with
# `git push --no-verify` when you genuinely mean to push a stale docs/.
#
# Installed via `git config core.hooksPath .githooks`, which is local to each clone.
# After re-cloning, run that command again or this file does nothing.

set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

command -v python3 >/dev/null 2>&1 || {
  echo "pre-push: python3 not found, skipping the docs/ freshness check." >&2; exit 0; }

TMP=$(mktemp -d) || exit 0
trap 'rm -rf "$TMP"' EXIT

cp build.py "$TMP/" 2>/dev/null || exit 0
cp -R data assets "$TMP/" 2>/dev/null || exit 0

if ! (cd "$TMP" && python3 build.py >/dev/null 2>&1); then
  echo "pre-push: build.py did not run, skipping the docs/ freshness check." >&2
  echo "          Run 'python3 build.py' yourself to see the error." >&2
  exit 0
fi

if diff -rq docs "$TMP/docs" >/dev/null 2>&1; then
  exit 0
fi

cat >&2 <<'MSG'

  PUSH BLOCKED: docs/ is out of date with data/.

  magnuslodefalk.com is served straight from main:/docs. Pushing now would publish
  nothing: the YAML would land in the repository and the live site would not move.

  What differs:
MSG
diff -rq docs "$TMP/docs" 2>&1 | sed 's/^/    /' >&2
cat >&2 <<'MSG'

  Fix:
      python3 build.py
      git add -A && git commit -m "Rebuild site"
      git push

  If you really mean to push a stale docs/, use: git push --no-verify

MSG
exit 1
